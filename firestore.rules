rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read and write only their own profile and favourites.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /favourites/{listingId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Any signed-in user can browse listings; only the seller can create or change their own.
    // Admin actions (e.g. setting status to "removed") are done in the Firebase console.
    match /listings/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.sellerId == request.auth.uid
                    && request.resource.data.status == 'active'
                    && request.resource.data.imageUrls.size() >= 4
                    && request.resource.data.imageUrls.size() <= 6;
      allow update: if request.auth != null
                    && resource.data.sellerId == request.auth.uid
                    && request.resource.data.sellerId == resource.data.sellerId
                    && request.resource.data.status in ['active', 'sold'];
      allow delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }

    // Reports can be created by signed-in users and read only by admins (console).
    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
